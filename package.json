{
  "name": "dsh-zed-space",
  "version": "1.0.1",
  "type": "module",
  "description": "Zed Space Skin · DeepSeek Harness 动态背景与界面皮肤",
  "icon": "./native-dist/icons/icon128.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hetonghao/dsh-zed-space.git"
  },
  "homepage": "https://github.com/hetonghao/dsh-zed-space",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/hetonghao/dsh-zed-space/issues",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "skin",
    "webgpu",
    "ocean"
  ],
  "main": "plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/index.js",
    "plugin/market-server.js",
    "plugin/client.js",
    "plugin/locale/*.json",
    "native-dist/icons/icon128.png",
    "cordis.patch.yml",
    "native-dist/loader.js",
    "native-dist/ocean.js",
    "native-dist/skin.html",
    "native-dist/cosmos.html",
    "native-dist/cosmos.js",
    "native-dist/styles.css",
    "native-dist/skins/**/*",
    "native-dist/vendor/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md",
    "native-dist/video.html",
    "native-dist/video.js",
    "native-dist/video-media.js",
    "SECURITY.md",
    "docs/video-background.md",
    "docs/market-integration.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs && node scripts/build-dsh-bundle.mjs",
    "build:site": "node scripts/build-pages.mjs",
    "check:generated": "node scripts/build-runtime.mjs --check && node scripts/build-dsh-bundle.mjs --check",
    "prepublishOnly": "npm run build && npm run check:generated",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build:site && npm run check:generated && npm test",
    "package:extension": "bash scripts/package-extension.sh",
    "test:browser": "node scripts/browser-acceptance.mjs",
    "test:settings": "node scripts/settings-ui-acceptance.mjs",
    "test:desktop": "node scripts/desktop-acceptance.mjs && node scripts/official-desktop-acceptance.mjs",
    "test:website": "node scripts/website-acceptance.mjs && node scripts/website-loading-acceptance.mjs",
    "capture": "node scripts/capture-gallery.mjs",
    "test:video": "node scripts/video-acceptance.mjs && node scripts/video-edge-acceptance.mjs && node scripts/video-paths-acceptance.mjs",
    "test:transitions": "node scripts/skin-transition-acceptance.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  },
  "license": "MIT"
}
