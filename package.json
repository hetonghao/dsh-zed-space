{
  "name": "dsh-backspace",
  "version": "1.2.6",
  "type": "module",
  "description": "DeepSeek Harness 实时海面与宇宙背景皮肤，支持共享参数和双视角平滑切换",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hetonghao/dsh-backspace.git"
  },
  "homepage": "https://hetonghao.github.io/dsh-backspace/",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/hetonghao/dsh-backspace/issues",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "skin",
    "webgpu",
    "ocean"
  ],
  "main": "plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/index.js",
    "plugin/client.js",
    "cordis.patch.yml",
    "native-dist/loader.js",
    "native-dist/ocean.js",
    "native-dist/skin.html",
    "native-dist/cosmos.html",
    "native-dist/cosmos.js",
    "native-dist/styles.css",
    "native-dist/skins/**/*",
    "native-dist/vendor/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs && node scripts/build-dsh-bundle.mjs",
    "build:site": "node scripts/build-pages.mjs",
    "check:generated": "node scripts/build-runtime.mjs --check && node scripts/build-dsh-bundle.mjs --check",
    "prepublishOnly": "npm run build && npm run check:generated",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build:site && npm run check:generated && npm test",
    "package:extension": "bash scripts/package-extension.sh",
    "test:browser": "node scripts/browser-acceptance.mjs",
    "test:desktop": "node scripts/desktop-acceptance.mjs && node scripts/official-desktop-acceptance.mjs",
    "test:website": "node scripts/website-acceptance.mjs && node scripts/website-loading-acceptance.mjs",
    "capture": "node scripts/capture-gallery.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  },
  "license": "MIT"
}
